<%= form_with model: question, url: (question.new_record? ? form_questions_path(form) : form_question_path(form, question)), class: "card flex flex-col gap", data: { controller: "toggle-fields" } do |f| %>
  <div class="field">
    <%= f.label :label, "Frage", class: "field__label" %>
    <%= f.text_field :label, required: true, maxlength: 200, autofocus: true, class: "input" %>
    <%= field_error(question, :label) %>
  </div>

  <div class="field">
    <%= f.label :kind, "Fragetyp", class: "field__label" %>
    <%= f.select :kind, FormQuestion::KINDS.invert, {}, class: "input", data: { toggle_fields_source: true, action: "toggle-fields#update" } %>
    <%= field_error(question, :kind) %>
  </div>

  <div class="field" data-toggle-fields-target="section" data-show-for="<%= FormQuestion::CHOICE_KINDS.join(" ") %>">
    <%= f.label :choices_text, "Antwortmöglichkeiten", class: "field__label" %>
    <%= f.text_area :choices_text, rows: 5, class: "input" %>
    <p class="field__hint">Eine Möglichkeit pro Zeile.</p>
    <%= field_error(question, :choices) %>
  </div>

  <div class="field">
    <%= f.label :help_text, "Hinweis (optional)", class: "field__label" %>
    <%= f.text_field :help_text, maxlength: 300, class: "input" %>
    <p class="field__hint">Erscheint klein unter der Frage.</p>
    <%= field_error(question, :help_text) %>
  </div>

  <label class="field field--inline">
    <%= f.check_box :required, class: "switch" %>
    <span class="text-sm">Pflichtfrage</span>
  </label>

  <div class="card__footer flex items-center gap">
    <%= f.submit "Speichern", class: "btn btn--primary" %>
    <%= link_to "Abbrechen", form_path(form), class: "btn btn--borderless" %>
  </div>
<% end %>
