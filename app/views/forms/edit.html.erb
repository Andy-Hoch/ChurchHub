<% content_for :title, "Einstellungen – #{@form.title}" %>

<%= render "header", form: @form, current: :settings %>

<%= form_with model: @form, url: form_path(@form), method: :patch, class: "card flex flex-col gap" do |form| %>
  <div class="field">
    <%= form.label :title, "Titel", class: "field__label" %>
    <%= form.text_field :title, required: true, maxlength: 80, class: "input" %>
    <%= field_error(@form, :title) %>
  </div>

  <div class="field">
    <%= form.label :intro, "Begrüßungstext (optional)", class: "field__label" %>
    <%= form.text_area :intro, rows: 3, maxlength: 1000, class: "input" %>
    <p class="field__hint">Erscheint vor der ersten Frage. Ohne Text startet das Formular direkt mit der ersten Frage.</p>
    <%= field_error(@form, :intro) %>
  </div>

  <div class="field">
    <%= form.label :thank_you_message, "Danke-Text (optional)", class: "field__label" %>
    <%= form.text_area :thank_you_message, rows: 2, maxlength: 1000, placeholder: "Vielen Dank! Wir haben deine Angaben erhalten.", class: "input" %>
    <%= field_error(@form, :thank_you_message) %>
  </div>

  <div class="field">
    <%= form.label :submit_label, "Text des Absenden-Buttons (optional)", class: "field__label" %>
    <%= form.text_field :submit_label, maxlength: 30, placeholder: "Absenden", class: "input" %>
    <%= field_error(@form, :submit_label) %>
  </div>

  <h2 class="font-medium mbs-2">Verfügbarkeit</h2>
  <div class="field-row">
    <div class="field">
      <%= form.label :opens_at, "Verfügbar ab (optional)", class: "field__label" %>
      <%= form.datetime_local_field :opens_at, class: "input" %>
      <%= field_error(@form, :opens_at) %>
    </div>
    <div class="field">
      <%= form.label :closes_at, "Verfügbar bis (optional)", class: "field__label" %>
      <%= form.datetime_local_field :closes_at, class: "input" %>
      <%= field_error(@form, :closes_at) %>
    </div>
  </div>
  <p class="field__hint">Außerhalb dieses Zeitraums erscheint der Button nicht im Hub und das Formular nimmt nichts an. Änderungen erscheinen auf eurer Webseite nach spätestens 5 Minuten.</p>

  <div class="field">
    <%= form.label :submission_limit, "Höchstzahl an Einsendungen (optional)", class: "field__label" %>
    <%= form.number_field :submission_limit, min: 1, step: 1, class: "input" %>
    <p class="field__hint">Gezählt werden die gespeicherten Einsendungen. Werden Einsendungen gelöscht, ist wieder Platz frei.</p>
    <%= field_error(@form, :submission_limit) %>
  </div>

  <div class="flex flex-col gap" data-controller="toggle-fields">
    <fieldset class="field">
      <legend class="field__label">Wenn die Höchstzahl erreicht ist</legend>
      <div class="choice-group">
        <label class="choice">
          <%= form.radio_button :when_full, "hide", data: { toggle_fields_source: true, action: "toggle-fields#update" } %>
          <span>Button ausblenden</span>
        </label>
        <label class="choice">
          <%= form.radio_button :when_full, "notice", data: { toggle_fields_source: true, action: "toggle-fields#update" } %>
          <span>Button zeigen, mit Hinweis</span>
        </label>
      </div>
    </fieldset>

    <div class="field" data-toggle-fields-target="section" data-show-for="notice">
      <%= form.label :full_message, "Hinweistext (optional)", class: "field__label" %>
      <%= form.text_area :full_message, rows: 2, maxlength: 1000, placeholder: t("forms.full_message"), class: "input" %>
      <%= field_error(@form, :full_message) %>
    </div>
  </div>

  <h2 class="font-medium mbs-2">Benachrichtigung</h2>
  <div class="field">
    <%= form.label :notification_emails, "E-Mail an (optional)", class: "field__label" %>
    <%= form.text_field :notification_emails, placeholder: "pastor@gemeinde.de, buero@gemeinde.de", class: "input" %>
    <p class="field__hint">Mehrere Adressen mit Komma trennen. Die E-Mail enthält nur einen Hinweis und einen Link, keine Antworten.</p>
    <%= field_error(@form, :notification_emails) %>
  </div>

  <h2 class="font-medium mbs-2">Datenschutz</h2>
  <div class="field">
    <%= form.label :consent_text, "Einwilligungstext (optional)", class: "field__label" %>
    <%= form.text_area :consent_text, rows: 2, maxlength: 1000, placeholder: "Ich bin einverstanden, dass meine Angaben zur Bearbeitung meiner Anfrage gespeichert werden.", class: "input" %>
    <p class="field__hint">Wenn ausgefüllt, muss vor dem Absenden ein Häkchen gesetzt werden.</p>
    <%= field_error(@form, :consent_text) %>
  </div>

  <div class="field">
    <%= form.label :privacy_url, "Link zur Datenschutzerklärung (optional)", class: "field__label" %>
    <%= form.url_field :privacy_url, placeholder: "https://", class: "input" %>
    <p class="field__hint">Wird vor dem Absenden verlinkt – mit oder ohne Einwilligungstext.</p>
    <%= field_error(@form, :privacy_url) %>
  </div>

  <div class="field">
    <%= form.label :retention_months, "Einsendungen automatisch löschen", class: "field__label" %>
    <%= form.select :retention_months, [ [ "Nie", nil ] ] + Form::RETENTION_OPTIONS.map { |months| [ "nach #{pluralize(months, "Monat", plural: "Monaten")}", months ] }, {}, class: "input" %>
    <%= field_error(@form, :retention_months) %>
  </div>

  <div class="card__footer flex items-center gap">
    <%= form.submit "Speichern", class: "btn btn--primary" %>
    <%= link_to "Abbrechen", form_path(@form), class: "btn btn--borderless" %>
  </div>
<% end %>

<div class="card flex flex-col gap mbs-4">
  <h2 class="font-medium">Formular löschen</h2>
  <p class="text-sm text-subtle">Löscht das Formular mit allen Fragen und Einsendungen. Verknüpfte Buttons werden im Launcher ausgeblendet.</p>
  <div>
    <%= button_to "Formular löschen", form_path(@form), method: :delete, class: "btn btn--negative", form: { data: { turbo_confirm: "„#{@form.title}“ mit allen Einsendungen wirklich löschen?" } } %>
  </div>
</div>
