<% content_for :title, "Passwort vergessen" %>

<h1 class="font-bold text-2xl">Passwort vergessen?</h1>
<p class="text-sm text-subtle">Wir schicken dir einen Link, mit dem du ein neues Passwort festlegen kannst.</p>

<%= form_with url: passwords_path, class: "flex flex-col gap" do |form| %>
  <div class="field">
    <%= form.label :email_address, "E-Mail-Adresse", class: "field__label" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "input" %>
  </div>
  <%= form.submit "Link senden", class: "btn btn--primary i-min" %>
<% end %>

<%= link_to "Zurück zur Anmeldung", new_session_path, class: "text-sm font-medium text-link" %>
