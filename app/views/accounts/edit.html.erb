<% content_for :title, "Mein Konto" %>

<div class="flex flex-col gap-double">
  <section class="flex flex-col gap">
    <h1 class="font-bold text-2xl">Mein Konto</h1>

    <div class="card flex flex-col gap">
      <div>
        <div class="field__label">Name</div>
        <div class="font-medium"><%= Current.user.name %></div>
      </div>
      <div>
        <div class="field__label">E-Mail-Adresse</div>
        <div class="font-medium"><%= Current.user.email_address %></div>
      </div>
    </div>
  </section>

  <section class="flex flex-col gap">
    <h2 class="font-semibold text-lg">Passwort ändern</h2>

    <%= form_with url: account_password_path, method: :patch, class: "card flex flex-col gap" do |form| %>
      <div class="field">
        <%= form.label :current_password, "Aktuelles Passwort", class: "field__label" %>
        <%= form.password_field :current_password, required: true, autocomplete: "current-password", maxlength: 72, class: "input" %>
      </div>
      <div class="field">
        <%= form.label :password, "Neues Passwort", class: "field__label" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72, class: "input" %>
      </div>
      <div class="field">
        <%= form.label :password_confirmation, "Neues Passwort wiederholen", class: "field__label" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72, class: "input" %>
      </div>
      <div class="card__footer">
        <%= form.submit "Passwort ändern", class: "btn btn--primary" %>
      </div>
    <% end %>
  </section>

  <details class="disclosure">
    <summary class="disclosure__summary">
      <span class="disclosure__title">Konto löschen</span>
      <span class="icon icon--chevron-right disclosure__icon" aria-hidden="true"></span>
    </summary>

    <div class="disclosure__content flex flex-col gap">
      <p class="text-sm">Löscht dein Konto endgültig. Das lässt sich nicht rückgängig machen. Mit deinen Kirchen passiert Folgendes:</p>

      <% if @churches.any? %>
        <ul class="list">
          <% @churches.each do |church| %>
            <% owner_after = Current.user.owner_after_closing_account(church) %>
            <li class="list-row flex items-center gap">
              <div class="flex-1 min-i-0">
                <div class="font-medium"><%= church.name %></div>
                <div class="text-sm text-subtle">
                  <% if owner_after %>
                    Bleibt für die anderen Mitglieder erhalten. Besitzer: <%= owner_after.name %>
                  <% else %>
                    Wird mit Hub und allen Links gelöscht, weil es keine weiteren Mitglieder gibt.
                  <% end %>
                </div>
              </div>
              <span class="badge <%= "badge--negative" unless owner_after %>"><%= owner_after ? "Bleibt" : "Wird gelöscht" %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-subtle">Du bist in keiner Kirche Mitglied.</p>
      <% end %>

      <%= form_with url: account_path, method: :delete, namespace: "account_deletion", class: "flex flex-col gap" do |form| %>
        <div class="field">
          <%= form.label :password, "Zum Bestätigen dein Passwort eingeben", class: "field__label" %>
          <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "input" %>
        </div>
        <%= form.submit "Konto endgültig löschen", class: "btn btn--negative i-min" %>
      <% end %>
    </div>
  </details>
</div>
