<% content_for :title, "Anmelden" %>

<h1 class="font-bold text-2xl">Anmelden</h1>

<%= form_with url: session_url, class: "flex flex-col gap" do |form| %>
  <div class="field">
    <%= form.label :email_address, "E-Mail-Adresse", class: "field__label" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "input" %>
  </div>

  <div class="field">
    <%= form.label :password, "Passwort", class: "field__label" %>
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "input" %>
  </div>

  <div class="flex items-center justify-between gap">
    <%= form.submit "Anmelden", class: "btn btn--primary" %>
    <%= link_to "Passwort vergessen?", new_password_path, class: "text-sm font-medium text-link" %>
  </div>
<% end %>

<p class="text-sm text-subtle">
  Noch kein Konto? <%= link_to "Jetzt registrieren", new_registration_path, class: "font-medium text-link" %>
</p>
