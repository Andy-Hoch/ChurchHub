<% content_for :title, "Kirche" %>
<% owner = current_membership&.owner? %>

<div class="flex flex-col gap-double">
  <section class="flex flex-col gap">
    <h1 class="font-bold text-2xl">Kirche</h1>

    <%= form_with model: @church, url: church_path, method: :patch, class: "card flex flex-col gap" do |form| %>
      <fieldset class="flex flex-col gap" <%= "disabled" unless owner %>>
        <div class="field">
          <%= form.label :name, "Name", class: "field__label" %>
          <%= form.text_field :name, required: true, class: "input" %>
          <%= field_error(@church, :name) %>
        </div>
        <div class="field">
          <%= form.label :website_url, "Webseite (optional)", class: "field__label" %>
          <%= form.text_field :website_url, inputmode: "url", autocomplete: "url", placeholder: "https://kirche-musterstadt.de", class: "input" %>
          <p class="field__hint">Wenn angegeben, wird der Launcher nur auf dieser Webseite und ihren Subdomains angezeigt. Leer lassen = überall erlaubt.</p>
          <%= field_error(@church, :website_url) %>
        </div>
        <div class="field">
          <%= form.label :slug, "Kurzname", class: "field__label" %>
          <%= form.text_field :slug, required: true, class: "input" %>
          <p class="field__hint">Nur Kleinbuchstaben, Zahlen und Bindestriche.</p>
          <%= field_error(@church, :slug) %>
        </div>

        <h2 class="font-medium mbs-2">Datenschutz in Formularen</h2>
        <div class="field">
          <%= form.label :consent_text, "Einwilligungstext (optional)", class: "field__label" %>
          <%= form.text_area :consent_text, rows: 2, maxlength: 1000, placeholder: "Ich bin einverstanden, dass meine Angaben zur Bearbeitung meiner Anfrage gespeichert werden.", class: "input" %>
          <p class="field__hint">Wenn ausgefüllt, muss in jedem Formular vor dem Absenden ein Häkchen gesetzt werden.</p>
          <%= field_error(@church, :consent_text) %>
        </div>
        <div class="field">
          <%= form.label :privacy_url, "Link zur Datenschutzerklärung (optional)", class: "field__label" %>
          <%= form.url_field :privacy_url, placeholder: "https://", class: "input" %>
          <p class="field__hint">Wird in jedem Formular vor dem Absenden verlinkt – mit oder ohne Einwilligungstext.</p>
          <%= field_error(@church, :privacy_url) %>
        </div>
      </fieldset>
      <% if owner %>
        <div class="card__footer">
          <%= form.submit "Speichern", class: "btn btn--primary" %>
        </div>
      <% end %>
    <% end %>
  </section>

  <section class="flex flex-col gap">
    <h2 class="font-semibold text-lg">Mitglieder</h2>

    <% memberships = @church.memberships.includes(:user).order(:created_at).to_a %>
    <% several_owners = memberships.count(&:owner?) > 1 %>
    <ul class="list">
      <% memberships.each do |membership| %>
        <li class="list-row flex items-center gap">
          <div class="flex-1 min-i-0">
            <div class="font-medium"><%= membership.user.name %></div>
            <div class="text-subtle"><%= membership.user.email_address %></div>
          </div>
          <span class="badge <%= "badge--primary" if membership.owner? %>"><%= membership.owner? ? "Besitzer" : "Admin" %></span>
          <% if owner && membership.admin? %>
            <%= button_to "Zum Besitzer machen", church_membership_path(membership), method: :patch, params: { role: :owner }, class: "btn btn--sm",
                  form: { data: { turbo_confirm: "#{membership.user.name} zum Besitzer machen? Besitzer dürfen die Einstellungen ändern, Mitglieder verwalten und die Kirche löschen." } } %>
          <% elsif owner && several_owners %>
            <%= button_to "Zum Admin machen", church_membership_path(membership), method: :patch, params: { role: :admin }, class: "btn btn--sm",
                  form: { data: { turbo_confirm: membership.user == Current.user ? "Deine Besitzer-Rechte abgeben? Danach kannst du die Einstellungen nicht mehr ändern." : "#{membership.user.name} zum Admin machen?" } } %>
          <% end %>
          <% if owner && membership.user != Current.user %>
            <%= button_to "Entfernen", church_membership_path(membership), method: :delete, class: "btn btn--sm btn--negative", form: { data: { turbo_confirm: "#{membership.user.name} entfernen?" } } %>
          <% end %>
        </li>
      <% end %>
    </ul>

    <% if owner %>
      <%= form_with url: church_memberships_path, class: "card flex flex-col gap" do |form| %>
        <div class="field">
          <%= form.label :email_address, "Mitglied hinzufügen", class: "field__label" %>
          <div class="flex gap">
            <%= form.email_field :email_address, required: true, disabled: true, placeholder: "E-Mail-Adresse eines registrierten Kontos", class: "input" %>
            <%= form.submit "Hinzufügen", disabled: true, class: "btn" %>
          </div>
          <p class="field__hint"><strong>Bald verfügbar:</strong> Mitglieder hinzufügen ist noch nicht möglich. Die Person muss bereits ein Konto haben. Neue Mitglieder sind Admins. Um die Kirche zu übergeben, machst du jemanden zum Besitzer und dich danach selbst zum Admin.</p>
        </div>
      <% end %>
    <% end %>
  </section>

  <% if owner %>
    <section class="flex flex-col gap">
      <h2 class="font-semibold text-lg">Kirche löschen</h2>

      <div class="card flex flex-col gap">
        <p class="text-sm">Löscht „<%= @church.name %>“ mit Hub und allen Links. Die Einbettung auf eurer Webseite und die eigene Seite funktionieren danach nicht mehr, und alle Mitglieder verlieren den Zugang. Das lässt sich nicht rückgängig machen.</p>

        <% if Current.user.churches.one? %>
          <p class="text-sm text-subtle">Das ist deine einzige Kirche, deshalb kannst du sie nicht einzeln löschen. Du kannst stattdessen <%= link_to "dein Konto löschen", edit_account_path, class: "font-medium text-link" %>.</p>
        <% else %>
          <%= form_with url: church_path, method: :delete, class: "flex flex-col gap" do |form| %>
            <div class="field">
              <%= form.label :confirmation, "Zum Bestätigen „#{@church.name}“ eintippen", class: "field__label" %>
              <%= form.text_field :confirmation, required: true, autocomplete: "off", class: "input" %>
            </div>
            <div class="card__footer">
              <%= form.submit "Kirche endgültig löschen", class: "btn btn--negative" %>
            </div>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
