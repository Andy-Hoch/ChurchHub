<% content_for :title, "Neue Kirche" %>

<h1 class="font-bold text-2xl mbe-4">Neue Kirche anlegen</h1>

<%= form_with model: @church, url: churches_path, class: "card flex flex-col gap" do |form| %>
  <div class="field">
    <%= form.label :name, "Name der Kirche", class: "field__label" %>
    <%= form.text_field :name, required: true, autofocus: true, class: "input" %>
    <%= field_error(@church, :name) %>
  </div>
  <div class="field">
    <%= form.label :website_url, "Webseite der Gemeinde (optional)", class: "field__label" %>
    <%= form.text_field :website_url, inputmode: "url", autocomplete: "url", placeholder: "https://kirche-musterstadt.de", class: "input" %>
    <p class="field__hint">Wenn angegeben, wird der Launcher nur auf dieser Webseite und ihren Subdomains angezeigt. Leer lassen = überall erlaubt.</p>
    <%= field_error(@church, :website_url) %>
  </div>
  <div class="card__footer">
    <%= form.submit "Anlegen", class: "btn btn--primary" %>
  </div>
<% end %>
