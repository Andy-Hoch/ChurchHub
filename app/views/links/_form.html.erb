<%= form_with model: link, url: (link.new_record? ? hub_links_path : hub_link_path(link)), class: "card flex flex-col gap", data: { controller: "toggle-fields" } do |form| %>
  <div class="field">
    <%= form.label :title, "Titel", class: "field__label" %>
    <%= form.text_field :title, required: true, maxlength: 80, autofocus: true, class: "input" %>
    <%= field_error(link, :title) %>
  </div>

  <fieldset class="field">
    <legend class="field__label">Was passiert beim Klick?</legend>
    <div class="choice-group">
      <label class="choice">
        <%= form.radio_button :kind, "link", data: { toggle_fields_source: true, action: "toggle-fields#update" } %>
        <span>Webseite öffnen</span>
      </label>
      <label class="choice">
        <%= form.radio_button :kind, "form", data: { toggle_fields_source: true, action: "toggle-fields#update" } %>
        <span>Formular öffnen</span>
      </label>
    </div>
  </fieldset>

  <div class="field" data-toggle-fields-target="section" data-show-for="link">
    <%= form.label :url, "Adresse (URL)", class: "field__label" %>
    <%= form.url_field :url, required: true, placeholder: "https://", class: "input" %>
    <%= field_error(link, :url) %>
  </div>

  <div class="field" data-toggle-fields-target="section" data-show-for="form">
    <%= form.label :form_id, "Formular", class: "field__label" %>
    <% if @forms.any? %>
      <%= form.collection_select :form_id, @forms, :id, :title, { include_blank: "Bitte wählen …" }, required: true, class: "input" %>
      <p class="field__hint">Das Formular öffnet sich im Launcher im Vollbild, eine Frage nach der anderen.</p>
    <% else %>
      <p class="field__hint">Noch keine Formulare vorhanden. <%= link_to "Formular anlegen", new_form_path, class: "text-link" %></p>
    <% end %>
    <%= field_error(link, :form) %>
  </div>

  <details class="disclosure" data-controller="toggle-fields" <%= "open" if link.errors.attribute_names.intersect?(Link::Schedulable::ATTRIBUTES) %>>
    <summary class="disclosure__summary">
      <span data-toggle-fields-target="summary"><%= link_schedule_title(link) %></span>
      <span class="icon icon--chevron-right disclosure__icon" aria-hidden="true"></span>
    </summary>

    <div class="disclosure__content flex flex-col gap">
      <fieldset class="field">
        <legend class="field__label">Anzeigen</legend>
        <div class="choice-group">
          <% Link.schedules.each_key do |schedule| %>
            <label class="choice">
              <%= form.radio_button :schedule, schedule, data: { toggle_fields_source: true, toggle_fields_summary: schedule_title(schedule), action: "toggle-fields#update" } %>
              <span><%= schedule_name(schedule) %></span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <div class="flex flex-col gap" data-toggle-fields-target="section" data-show-for="weekly biweekly">
        <fieldset class="field">
          <legend class="field__label">Wochentage</legend>
          <div class="choice-group">
            <%= form.collection_check_boxes :weekdays, weekday_options, :last, :first do |box| %>
              <label class="choice">
                <%= box.check_box %>
                <span><%= box.text %></span>
              </label>
            <% end %>
          </div>
          <%= field_error(link, :weekdays) %>
        </fieldset>

        <div class="field-row">
          <div class="field">
            <%= form.label :start_time, "Von (Uhrzeit)", class: "field__label" %>
            <%= form.time_field :start_time, required: true, class: "input" %>
            <%= field_error(link, :start_time) %>
          </div>
          <div class="field">
            <%= form.label :end_time, "Bis (Uhrzeit)", class: "field__label" %>
            <%= form.time_field :end_time, required: true, class: "input" %>
            <%= field_error(link, :end_time) %>
          </div>
        </div>
      </div>

      <div class="flex flex-col gap" data-toggle-fields-target="section" data-show-for="period weekly biweekly">
        <div class="field-row">
          <div class="field">
            <%= form.label :visible_from, "Ab", class: "field__label" %>
            <%= form.datetime_local_field :visible_from, class: "input" %>
            <%= field_error(link, :visible_from) %>
          </div>
          <div class="field">
            <%= form.label :visible_until, "Bis", class: "field__label" %>
            <%= form.datetime_local_field :visible_until, class: "input" %>
            <%= field_error(link, :visible_until) %>
          </div>
        </div>
        <p class="field__hint">
          Bei „Jede Woche“ optional. Bei „Alle 2 Wochen“ zählt die Woche des Startdatums als erste.
          Änderungen erscheinen auf eurer Webseite nach spätestens 5 Minuten.
        </p>
      </div>
    </div>
  </details>

  <label class="field field--inline">
    <%= form.check_box :visible, class: "switch" %>
    <span class="text-sm">Im Launcher anzeigen</span>
  </label>

  <div class="card__footer flex items-center gap">
    <%= form.submit "Speichern", class: "btn btn--primary" %>
    <%= link_to "Abbrechen", hub_path, class: "btn btn--borderless" %>
  </div>
<% end %>
