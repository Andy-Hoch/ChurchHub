    ".panel { box-sizing: border-box; width: min(360px, calc(100vw - 40px)); max-height: min(560px, calc(100vh - 110px)); overflow: auto; background: light-dark(oklch(100% 0 0), oklch(21.03% 0.0059 285.89)); color: light-dark(oklch(14.08% 0.0044 285.82), oklch(98.51% 0 0)); border: 1px solid light-dark(oklch(91.97% 0.004 286.32), oklch(37.03% 0.0119 285.81)); border-radius: var(--radius); box-shadow: 0 20px 25px -5px oklch(0% 0 0 / .15), 0 8px 10px -6px oklch(0% 0 0 / .1); transform-origin: bottom right; animation: ph-in .18s ease-out; }",
