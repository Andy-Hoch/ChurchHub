<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="utf-8">
    <title><%= @hub.title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="color-scheme" content="<%= @hub.color_scheme == "auto" ? "light dark" : @hub.color_scheme %>">
    <meta name="theme-color" content="<%= @hub.primary_color %>">
    <meta property="og:title" content="<%= @hub.title %>">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <style>
      :root {
        --primary: <%= @hub.primary_color %>;
        --on-primary: <%= @hub.text_color %>;
        --radius: <%= @hub.corner_radius %>px;
        color-scheme: <%= @hub.color_scheme == "auto" ? "light dark" : @hub.color_scheme %>;
        --bg: light-dark(#f4f4f5, #09090b);
        --surface: light-dark(#fff, #18181b);
        --border: light-dark(#e4e4e7, #3f3f46);
        --fg: light-dark(#09090b, #fafafa);
        --muted: light-dark(#71717a, #a1a1aa);
        --hover: light-dark(#f4f4f5, #27272a);
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body { margin: 0; min-height: 100vh; min-height: 100dvh; background: var(--bg); color: var(--fg); font: 400 16px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
      .header { background: var(--primary); color: var(--on-primary); padding: max(40px, env(safe-area-inset-top)) 16px 72px; text-align: center; }
      .title { margin: 0 auto; max-width: 36rem; font-size: clamp(1.5rem, 5vw, 2rem); font-weight: 700; line-height: 1.2; overflow-wrap: anywhere; }
      main { max-width: 36rem; margin: -48px auto 0; padding: 0 16px max(32px, env(safe-area-inset-bottom)); }
      .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
      .link { display: flex; align-items: center; gap: 14px; min-height: 64px; padding: 14px 16px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); color: inherit; text-decoration: none; box-shadow: 0 1px 3px rgb(0 0 0 / .06); transition: transform .15s ease, background-color .15s ease; }
      .link:hover { background: var(--hover); }
      .link:active { transform: scale(.98); }
      .link:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
      .emoji { font-size: 24px; width: 32px; text-align: center; flex-shrink: 0; }
      .text { flex: 1; min-width: 0; }
      .link-title { display: block; font-weight: 600; overflow-wrap: anywhere; }
      .link-description { display: block; font-size: 14px; color: var(--muted); overflow-wrap: anywhere; }
      .chevron { width: 18px; height: 18px; flex-shrink: 0; color: var(--muted); fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
      .empty { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px 16px; margin: 0; text-align: center; color: var(--muted); }
      @media (prefers-reduced-motion: reduce) { .link { transition: none; } }
    </style>
  </head>
  <body>
    <header class="header">
      <h1 class="title"><%= @hub.title %></h1>
    </header>
    <main>
      <% if @links.any? %>
        <ul class="list">
          <% @links.each do |link| %>
            <li>
              <a class="link" href="<%= link.url %>" target="_blank" rel="noopener">
                <span class="emoji" aria-hidden="true"><%= link.icon.presence || "🔗" %></span>
                <span class="text">
                  <span class="link-title"><%= link.title %></span>
                  <% if link.description.present? %><span class="link-description"><%= link.description %></span><% end %>
                </span>
                <svg class="chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
              </a>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="empty">Noch keine Links vorhanden.</p>
      <% end %>
    </main>
  </body>
</html>
